# -----------------------------------------------------------------------------
# Secrets & Environment Variables (Strictly Blocked)
# -----------------------------------------------------------------------------
.env
.env.*
*.env
backend/.env
backend/.env.*
# Allow harmless template examples only
!.env.example
!backend/.env.example

# -----------------------------------------------------------------------------
# Customer File Upload Staging (Multi-Tenant Isolation)
# -----------------------------------------------------------------------------
uploads/
backend/uploads/*
!backend/uploads/.gitkeep
*.pdf
*.png
*.jpg
*.jpeg
!vendor-app/assets/**
!vendor-app/android/app/src/main/res/**
!backend/static/**
!docs/screenshots/**

# -----------------------------------------------------------------------------
# Python, Virtual Environments & Testing Artifacts
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
*.log

# -----------------------------------------------------------------------------
# Mobile Build Artifacts (Android / Buildozer / Flutter)
# -----------------------------------------------------------------------------
.buildozer/
bin/
*.apk
*.aab
.flutter-plugins
.flutter-plugins-dependencies

# -----------------------------------------------------------------------------
# OS & IDE Configuration
# -----------------------------------------------------------------------------
.DS_Store
.vscode/
.idea/
node_modules/


# -----------------------------------------------------------------------------
# Database & Orders Store
# -----------------------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/*.db
backend/*.db-wal
backend/*.db-shm
orders_store.json
backend/orders_store.json

# -----------------------------------------------------------------------------
# Keystore & Android Signing Secrets
# -----------------------------------------------------------------------------
*.jks
*.keystore
key.properties
**/android/key.properties

# -----------------------------------------------------------------------------
# Gitignored Mobile Client Credentials & Firebase API Keys
# -----------------------------------------------------------------------------
vendor-app/lib/config/google_auth_config.dart
*google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist
*firebase-adminsdk*.json
*service-account*.json
